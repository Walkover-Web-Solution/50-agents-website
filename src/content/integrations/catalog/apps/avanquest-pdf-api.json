{"slug":"avanquest-pdf-api","name":"Avanquest PDF API","description":"Avanquest PDF API converts, merges, compresses, splits, OCRs, protects and extracts data from PDF files through a REST API.","icon":"https://storage.googleapis.com/stuff.thingsofbrand.com/developers.avanquest.com/images/img4_developers.avanquest.png","domain":"developers.avanquest.com","rank":101,"labels":["Documents","Developer Tools"],"categories":["documents","developer-tools"],"eventsRead":true,"events":[{"n":"Merge PDFs","d":"Merge two or more PDF files into a single PDF; provide file URLs and optional passwords, page ranges, or a callback URL.","t":"action","k":"hook"},{"n":"Convert Office Document to PDF","d":"Convert a Word, Excel, PowerPoint or OpenDocument file into a PDF.","t":"action","k":"hook"},{"n":"Convert PDF to Office Document","d":"Convert a PDF into a Word, Excel or PowerPoint file.","t":"action","k":"hook"},{"n":"Compress PDF","d":"Reduce the file size of a PDF at a chosen quality level.","t":"action","k":"hook"},{"n":"Split PDF","d":"Split a PDF into separate files by page or page ranges; supports password, label start, and callback URL.","t":"action","k":"hook"},{"n":"Convert HTML to PDF","d":"Turn a web page, HTML file or HTML content into a PDF.","t":"action","k":"hook"},{"n":"Convert Image To PDF","d":"Convert a JPG, PNG, BMP, or GIF image from a URL into a PDF. Optionally send a callback URL.","t":"action","k":"hook"},{"n":"Convert PDF or Image to Searchable Text","d":"Convert a PDF or image into searchable text; supports page ranges, passwords, deskew, and optional webhook callback.","t":"action","k":"hook"},{"n":"Convert PDF to Text","d":"Extract PDF text to a plain .txt file; set pages, password, cropping, divider, and webhook callback.","t":"action","k":"hook"},{"n":"Extract Document Data","d":"Extract structured data from a PDF or image document.","t":"action","k":"hook"},{"n":"Extract Document Fields","d":"Extract named fields (vendor, total, dates) from a document by supplying a file URL, fields list, and optional callback URL.","t":"action","k":"hook"},{"n":"Protect PDF with Password","d":"Set or change a PDF's open password by uploading a file, specifying a new password, and optional current password.","t":"action","k":"hook"},{"n":"Unlock PDF","d":"Remove password protection from a PDF by providing the file URL and password.","t":"action","k":"hook"},{"n":"Add Watermark to PDF","d":"Stamp a text or image watermark on the pages of a PDF.","t":"action","k":"hook"},{"n":"Get Operation Status","d":"Check whether a PDF operation is pending, processing, completed or failed.","t":"action","k":"hook"},{"n":"Download Operation Result","d":"Get the result of a completed PDF operation as a download link or content.","t":"action","k":"hook"},{"n":"New Operation Completed","d":"Runs when a PDF operation started with a callback URL finishes or fails.","t":"trigger","k":"hook"}],"recipes":[{"ta":"quo","te":"Receive Incoming Message","aa":"avanquest-pdf-api","ae":"Merge PDFs"},{"ta":"google-meet","te":"New Meeting","aa":"avanquest-pdf-api","ae":"Merge PDFs"},{"ta":"jibble","te":"New Clock In","aa":"avanquest-pdf-api","ae":"Merge PDFs"},{"ta":"recras","te":"New Booking Created","aa":"avanquest-pdf-api","ae":"Merge PDFs"},{"ta":"slack","te":"New Message Posted in Channel Instant","aa":"avanquest-pdf-api","ae":"Merge PDFs"},{"ta":"justcall","te":"Incoming Call","aa":"avanquest-pdf-api","ae":"Merge PDFs"},{"ta":"inflow-inventory","te":"Updated Purchase Order","aa":"avanquest-pdf-api","ae":"Merge PDFs"},{"ta":"todoist","te":"New Task Created in Project","aa":"avanquest-pdf-api","ae":"Merge PDFs"},{"ta":"zoho-crm","te":"New Account","aa":"avanquest-pdf-api","ae":"Merge PDFs"},{"ta":"sangam-crm","te":"Account Is Updated","aa":"avanquest-pdf-api","ae":"Merge PDFs"},{"ta":"todoist","te":"New Incomplete Task","aa":"avanquest-pdf-api","ae":"Merge PDFs"},{"ta":"templateto","te":"When a new template is created","aa":"avanquest-pdf-api","ae":"Merge PD