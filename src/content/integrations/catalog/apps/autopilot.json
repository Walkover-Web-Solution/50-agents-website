{"slug":"autopilot","name":"Autopilot","description":"Autopilot is a CRM and field service management app for home service businesses: clients, jobs, scheduling, estimates, invoices and payments.","icon":"https://storage.googleapis.com/stuff.thingsofbrand.com/autopilotapp.io/images/img9_autopilotapp.png","domain":"autopilotapp.io","rank":165,"labels":["CRM (Customer Relationship Management)","Field Service Management"],"categories":["crm"],"eventsRead":true,"events":[{"n":"Create Client","d":"Create a client or lead with contact details, service address and tags.","t":"action","k":"hook"},{"n":"Update Client","d":"Update a client's contact info, type, billing address, notes or preferences. Requires client ID; empty fields unchanged.","t":"action","k":"hook"},{"n":"Find Clients","d":"Search clients and leads by text, email, phone, type, tag or creation date.","t":"action","k":"hook"},{"n":"Add Client Address","d":"Add a service address to a client, optionally as the primary address.","t":"action","k":"hook"},{"n":"Create Job","d":"Create a job for a client with schedule, crew, line items and discount.","t":"action","k":"hook"},{"n":"Update Job","d":"Change a job's status, dates, notes, address or details. Empty fields stay unchanged.","t":"action","k":"hook"},{"n":"Find Jobs","d":"Find jobs by number, status, client, start date range or creation date.","t":"action","k":"hook"},{"n":"Create Invoice","d":"Create an invoice for a client, optionally from a job, with line items and discount.","t":"action","k":"hook"},{"n":"Update Invoice","d":"Change an invoice's status, due date, notes or other details. Empty fields stay unchanged.","t":"action","k":"hook"},{"n":"Record Invoice Payment","d":"Record a manual payment, such as cash or check, on an invoice.","t":"action","k":"hook"},{"n":"Find Invoices","d":"Find invoices by number, status, client, job, due date range or creation date.","t":"action","k":"hook"},{"n":"Create Estimate","d":"Create an estimate for a client with