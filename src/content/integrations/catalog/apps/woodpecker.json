{"slug":"woodpecker","name":"Woodpecker","description":"Woodpeaker is a tool designed to streamline and automate your email outreach campaigns, making it easier to connect with potential clients and partners. It offers features such as personalized email sequences, follow-ups, and analytics to enhance your communication strategy.","icon":"https://stuff.thingsofbrand.com/woodpecker.co/images/img64cb914a49_woodpecker.jpg","domain":"woodpecker.co","rank":1092,"labels":["Website Builders"],"categories":["app-builders"],"eventsRead":true,"events":[{"n":"Email Opened","d":"Triggers when a prospect opens the email.","t":"trigger","k":"hook"},{"n":"Prospect Interested","d":"Triggers when a prospect is marked as INTERESTED.","t":"trigger","k":"hook"},{"n":"Prospect Maybe Later","d":"Triggers when a prospect's interest level is marked as MAYBE LATER.","t":"trigger","k":"hook"},{"n":"Prospect Not Interested","d":"Triggers when a prospect is marked as NOT INTERESTED.","t":"trigger","k":"hook"},{"n":"Manual Task Created","d":"Triggers when a manual task of any type is created.","t":"trigger","k":"hook"},{"n":"Manual Task Done","d":"Triggers when a manual task is marked as done.","t":"trigger","k":"hook"},{"n":"Campaign Completed","d":"Triggers when a Woodpecker campaign is completed.","t":"trigger","k":"hook"},{"n":"Blacklist Domain","d":"Blocks a domain to automatically stop all ongoing and future messages to prospects within that domain.","t":"action","k":"hook"},{"n":"Create/Update Prospect","d":"Adds a new prospect or Updates existing prospect in the list of Prospects.","t":"action","k":"hook"},{"n":"Create or Update Prospect in Campaign","d":"Adds a new prospect or updates existing prospect in a specific campaign by email","t":"action","k":"hook"},{"n":"Get Prospect Responses","d":"Fetch all prospect's responses by email","t":"action","k":"hook"},{"n":"Find Prospect by Email","d":"Finds prospect by email address","t":"action","k":"hook"},{"n":"Stop Follow-Ups","d":"Stop fol