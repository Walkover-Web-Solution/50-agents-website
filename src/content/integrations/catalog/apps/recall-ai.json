{"slug":"recall-ai","name":"Recall.ai","description":"Recall.ai provides developer APIs for recording, transcribing, and analyzing meetings across Zoom, Google Meet, Microsoft Teams, Webex and more. Send meeting bots, get recordings and transcripts, and schedule bots from connected calendars.","icon":"https://stuff.thingsofbrand.com/recall.ai/images/img8_recall.png","domain":"recall.ai","rank":103,"labels":["Transcription","Video Conferencing","Developer Tools"],"categories":["ai-tools","communication","developer-tools"],"eventsRead":true,"events":[{"n":"Get Bot","d":"Get a bot with its status history, recordings and download links.","t":"action","k":"hook"},{"n":"List Bots","d":"List bots filtered by status, platform, meeting link or join time.","t":"action","k":"hook"},{"n":"Update Scheduled Bot","d":"Change the name, join time, meeting link or settings of a bot that has not joined yet.","t":"action","k":"hook"},{"n":"Send Bot to Meeting","d":"Send a bot to a Zoom, Google Meet, Teams or Webex meeting now or at a set time to record and transcribe it.","t":"action","k":"hook"},{"n":"Delete Scheduled Bot","d":"Delete a scheduled bot that has not joined its meeting yet.","t":"action","k":"hook"},{"n":"Send Chat Message","d":"Send a chat message from a bot into its meeting.","t":"action","k":"hook"},{"n":"Delete Bot Media","d":"Permanently delete the recordings, transcripts and other media stored for a bot.","t":"action","k":"hook"},{"n":"Get Recording","d":"Get a recording with its status and video, audio and transcript download links.","t":"action","k":"hook"},{"n":"Create Transcript","d":"Start a transcript for a finished recording, selecting language, speaker diarization, and optional metadata.","t":"action","k":"hook"},{"n":"Get Transcript","d":"Get a transcript with its status and, optionally, the full text by speaker.","t":"action","k":"hook"},{"n":"Schedule Bot for Calendar Event","d":"Schedule a bot to join a meeting from a connected calendar.","t":"action","k