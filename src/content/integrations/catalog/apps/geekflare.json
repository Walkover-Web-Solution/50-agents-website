{"slug":"geekflare","name":"Geekflare","description":"Geekflare is a suite of APIs to bring live web data into your automations. With viaSocket, use Geekflare to scrape and extract web content, run real-time search, capture full-page screenshots, check site load times, and pull DNS records.","icon":"https://cdn.geekflare.com/general/logo.svg","domain":"geekflare.com","rank":242,"labels":["Developer Tools"],"categories":["developer-tools"],"eventsRead":true,"events":[{"n":"Take Screenshot","d":"Take a screenshot of any site into full-page or view port using desktop or mobile device.","t":"action","k":"hook"},{"n":"Find DNS Records","d":"Get DNS records for a domain or URL.","t":"action","k":"hook"},{"n":"Get Website Metadata","d":"Get meta tags, Open Graph and Twitter Card data, and other structured metadata from a URL without loading the full page.","t":"action","k":"hook"},{"n":"Search Web","d":"Search the web or news with structured results","t":"action","k":"hook"},{"n":"Measure Page Load Time","d":"Measure how long a webpage takes to fully load in a real browser, optionally from up to 3 target countries and with redirect or proxy options.","t":"action","k":"hook"},{"n":"Check Website Status","d":"Verify a website is reachable and returns a successful HTTP response.","t":"action","k":"hook"},{"n":"Ping URL or IP Address","d":"Check connectivity to a URL or IP address and get latency, packet loss, and round-trip time (RTT) statistics.","t":"action","k":"hook"},{"n":"Find Open TCP Ports","d":"Scan a host for open TCP ports.","t":"action","k":"hook"},{"n":"Run Lighthouse Audit","d":"Run a Lighthouse performance audit for a URL. Optionally set device, follow redirects, proxy country, and comma-separated parameters.","t":"action","k":"hook"},{"n":"Create PDF From URL","d":"Create a PDF from a webpage URL, with options for device, format, orientation, scale, margins, cookie hiding, CAPTCHA handling, and timestamp.","t":"action","k":"hook"}],"recipes":[{"ta":"quo","te":