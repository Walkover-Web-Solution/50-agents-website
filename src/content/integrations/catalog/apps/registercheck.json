{"slug":"registercheck","name":"Registercheck","description":"Registercheck provides German commercial register (Handelsregister) data via API: company search, register entries, roles, shareholders, KYB reports, new formations and change monitoring.","icon":"https://storage.googleapis.com/stuff.thingsofbrand.com/registercheck.de/images/img0_registercheck.png","domain":"registercheck.de","rank":102,"labels":["Business Intelligence","Databases"],"categories":["analytics","databases"],"eventsRead":true,"events":[{"n":"Get Company","d":"Get the current register entry of a company, optionally with its current roles. Costs 10 credits.","t":"action","k":"hook"},{"n":"Search Companies","d":"Search German companies by name or register number, with optional court, type, status, city, and pagination.","t":"action","k":"hook"},{"n":"Search Persons","d":"Find natural persons named in the German register by name, birth year and city. Costs 1 credit per page.","t":"action","k":"hook"},{"n":"List Company Roles","d":"List a company's managing directors, board members and signatories. Filter by status, role type and pagination.","t":"action","k":"hook"},{"n":"List Company Shareholders","d":"List current shareholders or partners for a chosen company. Supports pagination (limit, cursor).","t":"action","k":"hook"},{"n":"Delete Monitor","d":"Stop monitoring a company by deleting its monitor. Enter the Monitor ID to remove it.","t":"action","k":"hook"},{"n":"Get KYB Report","d":"Assemble a KYB report: register entry, roles, shareholders, ownership tree and filings. Costs 50 credits.","t":"action","k":"hook"},{"n":"Create Monitor","d":"Start monitoring a company for register changes, by company ID or register identity. Costs 10 credits once.","t":"action","k":"hook"},{"n":"Add Item to List","d":"Add a company or person to one of your Registercheck lists, with an optional note. Free.","t":"action","k":"hook"},{"n":"New Company Formation","d":"Runs when a newly registered German company appears, filtered by legal form, state, office or capital.","t":"trigger","k":"polling"},{"n":"New Register Event","d":"Runs when a new register change is entered, for one of your monitors, one company or all companies.","t":"trigger","k":"polling"},{"n":"New Monitored Company Change","d":"Runs instantly when a register change is detected for any company you monitor in Registercheck.","t":"trigger","k":"hook"}],"recipes":[{"ta":"esignatures","te":"New Fully Signed Contract","aa":"registercheck","ae":"Get Company"},{"ta":"shopify","te":"New Customer","aa":"registercheck","ae":"Get Company"},{"ta":"vidnoz","te":"New Video Uploaded","aa":"registercheck","ae":"Get Company"},{"ta":"tallyprime","te":"Account Statement Exported","aa":"registercheck","ae":"Get Company"},{"ta":"stripe","te":"New Customer Created","aa":"registercheck","ae":"Get Company"},{"ta":"hubspot","te":"When a deal is created or updated","aa":"registercheck","ae":"Get Company"},{"ta":"zendesk-support","te":"New Organization Created or Updated","aa":"registercheck","ae":"Get Company"},{"ta":"airtable","te":"Record Created Or Updated","aa":"registercheck","ae":"Get Company"},{"ta":"contacts-plus","te":"Tag Updated","aa":"registercheck","ae":"Get Company"},{"ta":"recras","te":"New Booking Created","aa":"registercheck","ae":"Get Company"},{"ta":"slack","te":"New Thread Message","aa":"registercheck","ae":"Get Company"},{"ta":"postgresql","te":"Postgresql (mutiple table)","aa":"registercheck","ae":"Get Company"},{"ta":"Cal_ID","te":"Booking Cancelled","aa":"registercheck","ae":"Get Company"},{"ta":"tallyprime","te":"New Purchase event occurs","aa":"registercheck","ae":"Get Company"},{"ta":"razorpay","te":"Payment Fails","aa":"registercheck","ae":"Get Company"},{"ta":"gmail","te":"New Email Sent","aa":"registercheck","ae":"Get Company"},{"ta":"gtwy","te":"New Broadcast Response","aa":"registercheck","ae":"Get Company"},{"ta":"zoho-crm","te":"New Deals","aa":"registercheck","ae":"Get Company"},{"ta":"superchat","te