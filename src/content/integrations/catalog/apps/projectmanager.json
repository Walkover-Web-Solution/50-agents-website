{"slug":"projectmanager","name":"ProjectManager","description":"ProjectManager.com is a simple yet powerful online project management tool that enables you and your team to plan, track, monitor and report on your projects in real-time.","icon":"https://stuff.thingsofbrand.com/projectmanager.com/images/img60a3ca93b3_projectmanager.jpg","domain":"projectmanager.com","rank":1296,"labels":["Project Management","Team Collaboration","Time Tracking Software","Task Management"],"categories":["project-management"],"eventsRead":true,"events":[{"n":"Create Project","d":"Create a new project with name, manager, dates, members, status, budget, and optional settings.","t":"action","k":"hook"},{"n":"Create Task","d":"Create a new task in a chosen project, setting name, assignees, dates, priority, status, and more.","t":"action","k":"hook"},{"n":"New Resource Added","d":"Runs when a new person, material, or tool is added to your account","t":"trigger","k":"polling"},{"n":"New Project Created","d":"Runs when a new project is created in ProjectManager.","t":"trigger","k":"polling"},{"n":"New Task Created","d":"Runs when a new task is created, optionally only for a specific project.","t":"trigger","k":"polling"},{"n":"Timesheet Entry Created/Updated","d":"Runs when a timesheet entry is created/updated.","t":"trigger","k":"polling"},{"n":"Create Timesheet Entry","d":"Create a timesheet entry for a person, task, and date with hours and notes. Only one entry allowed per person/task/day.","t":"action","k":"hook"},{"n":"Update Project","d":"Update a project's details by project ID. Choose fields to update (name, target date, status, customer, manager).","t":"action","k":"hook"},{"n":"Update Task","d":"Update an existing task; empty fields remain unchanged.","t":"action","k":"hook"},{"n":"Update Timesheet Entry","d":"Update an existing timesheet entry's hours, minutes, or notes for a chosen timesheet ID.","t":"action","k":"hook"},{"n":"Get Project Details","d":"Retrieve details for a selected project. Optionally return only chosen fields.","t":"action","k":"hook"},{"n":"Get Task Details","d":"Get details for a specific task by task ID; choose which fields to return.","t":"action","k":"hook"},{"n":"List Project Priorities","d":"Retrieve priorities available to assign to a project.","t":"action","k":"hook"},{"n":"List Task Statuses","d":"Retrieve task statuses (board columns) available in a selected project.","t":"action","k":"hook"},{"n":"Create Resource","d":"Creates a new user in your ProjectManager account.","t":"action","k":"hook"},{"n":"Get User Details","d":"Fetch details for a user by ID. Choose the user ID to retrieve specific user information.","t":"action","k":"hook"},{"n":"List Project Folders","d":"Retrieve all project folders in your account.","t":"action","k":"hook"},{"n":"Update User","d":"Update an existing user or resource. Choose which fields to change (profile, assignments, appearance, schedule).","t":"action","k":"hook"},{"n":"List Workspaces","d":"List workspaces the current user can access; optionally select which fields to return.","t":"action","k":"hook"},{"n":"List User Roles","d":"Returns all user roles in the workspace; optionally select which fields to include.","t":"action","k":"hook"},{"n":"List Active Admin Tasks","d":"Retrieve active admin tasks from ProjectManager.","t":"action","k":"hook"},{"n":"List Timesheets","d":"Retrieve timesheet entries; choose Fetch All or Find Specific, apply filters, sort, paginate, and select fields.","t":"action","k":"hook"},{"n":"List Tasks","d":"Retrieve tasks that match your selected filters and search criteria.","t":"action","k":"hook"},{"n":"List User Teams","d":"Retrieve user teams with optional name filtering, paging (limit/skip) and sorting.","t":"action","k":"hook"},{"n":"List All Countries","d":"List all the countries available in the system.","t":"action","k":"hook"},{"n":"List Users","d":"List users with optional filters (role, team, active), search, sorting, pagination, and sel