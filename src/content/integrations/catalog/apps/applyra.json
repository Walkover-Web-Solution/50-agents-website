{"slug":"applyra","name":"Applyra","description":"Applyra is an App Store Optimization (ASO) platform for App Store and Google Play: keyword rank tracking, competitor intelligence, ASO Health audits and top charts.","icon":"https://storage.googleapis.com/stuff.thingsofbrand.com/applyra.io/images/img7_applyra.png","domain":"applyra.io","rank":118,"labels":["Marketing","Analytics"],"categories":["marketing-automation","analytics"],"eventsRead":true,"events":[{"n":"List Applications","d":"List all tracked applications with their scores, or get one application by ID.","t":"action","k":"hook"},{"n":"Track App","d":"Start tracking an App Store or Google Play app for a selected country and language using its store ID.","t":"action","k":"hook"},{"n":"Get ASO Health","d":"Get the full ASO Health audit of a tracked app: axes, field scores and what to fix.","t":"action","k":"hook"},{"n":"Get Visibility Score History","d":"Get the daily visibility score of a tracked app over a date range, with related events.","t":"action","k":"hook"},{"n":"Add Chart Note","d":"Add a note to an app's charts to mark a launch, campaign or metadata change.","t":"action","k":"hook"},{"n":"Add Keywords","d":"Add up to 20 keywords to an app and fetch their current rankings; set app and market options.","t":"action","k":"hook"},{"n":"Remove Keyword","d":"Stop tracking a keyword for an app; its ranking history is kept.","t":"action","k":"hook"},{"n":"List Tracked Keywords","d":"List tracked keywords with rank, traffic and difficulty, optionally for one app or favorites.","t":"action","k":"hook"},{"n":"Update Keyword Favorite","d":"Mark or unmark a tracked keyword as a favorite for an application.","t":"action","k":"hook"},{"n":"Get Keyword Rank History","d":"Get the daily rank history of a tracked keyword across your apps over a date range.","t":"action","k":"hook"},{"n":"List Competitors","d":"List tracked competitor apps, optionally for one of your applications.","t":"action","k":"hook"},{"n":"Add Co