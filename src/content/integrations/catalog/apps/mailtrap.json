{"slug":"mailtrap","name":"Mailtrap","description":"Mailtrap is an email delivery platform covering email sending (API/SMTP) bundled with inbound email, also featuring email testing (Sandbox), and Email Marketing. It's used by developer and product teams for transactional and bulk email delivery and offers reliable sending tools with built-in deliverability protection, including separation between transactional and bulk email, automatic authentication setup, and analytics insights broken down by mailbox provider.","icon":"https://stuff.thingsofbrand.com/mailtrap.io/images/img5_mailtrap.png","domain":"mailtrap.io","rank":676,"labels":["Email","Developer Tools","Testing"],"categories":["email","developer-tools"],"eventsRead":true,"events":[{"n":"Get Contact Lists","d":"Get your contact lists and their IDs.","t":"action","k":"hook"},{"n":"Create Contact","d":"Add a new contact to Mailtrap.","t":"action","k":"hook"},{"n":"Create Contact List","d":"Create a new Contact Lists.","t":"action","k":"hook"},{"n":"Delete Contact List","d":"Delete an existing Contact List.","t":"action","k":"hook"},{"n":"Delete Contact","d":"Delete a contact by email address.","t":"action","k":"hook"},{"n":"Update Contact","d":"Update an existing contact's details in Mailtrap.","t":"action","k":"hook"},{"n":"Delete Contact Field","d":"Delete a custom contact field from your Mailtrap account.","t":"action","k":"hook"},{"n":"New Email Delivered","d":"Runs when an email is delivered to the recipient's mail server for a chosen sending stream or domain.","t":"trigger","k":"hook"},{"n":"Send Transactional Email","d":"Send an email to real recipients through Mailtrap Email API/SMTP. Use a Mailtrap template or your own subject and body, and add attachments.","t":"action","k":"hook"},{"n":"New Email Opened","d":"Runs when a recipient opens an email in the selected sending stream.","t":"trigger","k":"hook"},{"n":"New Email Received","d":"Runs when a new email arrives in a selected Mailtrap Inbound Email inbox. Includes the sender, recipients, subject, headers, text and HTML bodies, and attachments. Webhook signatures are verified before the flow runs.","t":"trigger","k":"hook"},{"n":"List Sandbox Messages","d":"List the emails in a Sandbox inbox, with optional search and pagination.","t":"action","k":"hook"},{"n":"Retrieve Test Email","d":"Get a test email from a Sandbox inbox, including its headers.","t":"action","k":"hook"},{"n":"Retrieve Test Email Text Body","d":"Get the plain-text version of a test email.","t":"action","k":"hook"},{"n":"Get Sandbox Email HTML Body","d":"Get the HTML version of a test email.","t":"action","k":"hook"},{"n":"Check Test Email Spam Score","d":"Get a test email's spam score so you can catch deliverability problems before you send it for real.","t":"action","k":"hook"},{"n":"Analyze Test Email HTML","d":"Check a test email's HTML and CSS for elements that some email clients don't support.","t":"action","k":"hook"},{"n":"Forward Test Email","d":"Forward a test email to a teammate or reviewer. The address must be confirmed in Mailtrap first.","t":"action","k":"hook"},{"n":"Mark Test Email as Read","d":"Mark a test email as read in its Sandbox inbox.","t":"action","k":"hook"},{"n":"Delete Test Email","d":"Delete a test email from a Sandbox inbox.","t":"action","k":"hook"},{"n":"Clear Sandbox Inbox","d":"Delete all emails in a Sandbox inbox, for example before each test run.","t":"action","k":"hook"},{"n":"Contact Unsubscribed","d":"Runs when a contact unsubscribes from emails in the selected sending stream.","t":"trigger","k":"hook"},{"n":"Send Sandbox Email","d":"Send a test email to an Email Sandbox inbox instead of real recipients. Supports templates or custom bodies, CC/BCC, attachments, and custom headers.","t":"action","k":"hook"}],"recipes":[{"ta":"mailtrap","te":"New Email Received","aa":"google-drive","ae":"Create a new sheet or doc or slide"},{"ta":"mailtrap","te":"New Email Received","aa":"google-drive","ae":"Create Folder"},{