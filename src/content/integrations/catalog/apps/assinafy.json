{"slug":"assinafy","name":"Assinafy","description":"Assinafy is a Brazilian electronic signature platform that enables businesses to send, sign, and manage legally valid digital documents online, with a free API for integrations.","icon":"https://storage.googleapis.com/stuff.thingsofbrand.com/assinafy.com.br/images/img4_assinafy.com.png","domain":"assinafy.com.br","rank":199,"labels":["Documents","Developer Tools","Security and Identity Tools"],"categories":["documents","developer-tools"],"eventsRead":true,"events":[{"n":"Create Workspace","d":"Create a new workspace for the authenticated user and set its name and notification sender type.","t":"action","k":"hook"},{"n":"List Workspaces","d":"Retrieves all workspaces (accounts) from your Assinafy account.","t":"action","k":"hook"},{"n":"Delete Workspace","d":"Delete a workspace account by account ID; optionally force deletion.","t":"action","k":"hook"},{"n":"Delete Document","d":"Delete a document in deletable status by specifying its Document ID.","t":"action","k":"hook"},{"n":"Get Workspace Theme","d":"Retrieve a workspace's branding theme for a selected account.","t":"action","k":"hook"},{"n":"Get Workspace Document KPIs","d":"Retrieve document funnel KPIs for a workspace; set granularity (daily/monthly). Month is required when granularity is daily.","t":"action","k":"hook"},{"n":"Update Workspace","d":"Update the selected workspace profile and return the updated account.","t":"action","k":"hook"},{"n":"Upload Document","d":"Upload a PDF to create a document in a selected workspace.","t":"action","k":"hook"},{"n":"Rename Document","d":"Rename an Assinafy document before signing locks the name.","t":"action","k":"hook"},{"n":"List Document Tags","d":"List tags for a selected document in a chosen workspace.","t":"action","k":"hook"},{"n":"List Documents","d":"List documents in a chosen workspace with optional status, method, search, tags, sort, page, and per-page limit.","t":"action","k":"hook"},{"n":"Create Tags a