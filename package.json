{
  "name": "50-agents-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-landing-width.mjs && node scripts/sync-organization-ld.mjs && node scripts/validate-json-ld.mjs && node scripts/sync-landing-sections.mjs && node scripts/generate-llms-full.mjs",
    "build": "next build",
    "pages:live-pairs": "node scripts/pages/write-live-pairs.mjs",
    "build:dev": "dotenv -e .env.dev next build",
    "build:prod": "dotenv -e .env.prod next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/patch-next-on-pages.mjs"
  },
  "dependencies": {
    "next": "16.0.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9",
    "eslint-config-next": "16.0.5",
    "typescript": "^5",
    "vercel": "47.0.4"
  }
}
